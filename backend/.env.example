# Copiar este archivo como ".env" y completar los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha la API
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Conexión a MongoDB.
# - En desarrollo se puede dejar vacío: el backend levanta una base en memoria.
# - En producción es OBLIGATORIO (por ejemplo, una URI de MongoDB Atlas).
MONGO_URI=mongodb://127.0.0.1:27017/world_cup_26

# Clave para firmar los JWT. En producción usar una cadena larga y aleatoria.
JWT_SECRET=cambiar_esto_por_una_clave_larga_y_secreta

# Duración del token (formato de jsonwebtoken: 30m, 4h, 7d...)
JWT_EXPIRES_IN=4h

# URL(s) del frontend habilitadas para CORS. Se pueden separar por coma.
FRONTEND_URL=http://localhost:5173

# Administrador inicial que crea el seed la primera vez.
# Cambiar la contraseña por una propia antes de desplegar.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@worldcup26.com
ADMIN_PASSWORD=admin123456
